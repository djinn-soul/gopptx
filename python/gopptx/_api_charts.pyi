class Chart:
    @property
    def index(self) -> int: ...
    @property
    def rel_id(self) -> str: ...
    @property
    def chart_part(self) -> str: ...
    @property
    def chart_title(self) -> ChartTitle: ...
    @property
    def title_visible(self) -> bool: ...
    @title_visible.setter
    def title_visible(self, value: bool) -> None: ...
    @property
    def legend(self) -> ChartLegend: ...
    @property
    def plots(self) -> ChartPlots: ...
    @property
    def chart_area(self) -> ChartArea: ...
    @property
    def category_axis(self) -> ChartAxis: ...
    @property
    def value_axis(self) -> ChartAxis: ...
    @property
    def chart_style(self) -> int | None: ...
    @property
    def series(self) -> ChartSeriesCollection: ...
    @property
    def trendlines(self) -> TrendlineCollection: ...
    def add_trendline(
        self,
        trendline_type: str,
        *,
        series_index: int = 0,
        **options: object,
    ) -> None: ...
    def set_trendlines(
        self,
        trendlines: Sequence[ChartTrendlineSpec],
        *,
        series_index: int = 0,
    ) -> None: ...
    def clear_trendlines(self, *, series_index: int = 0) -> None: ...
    @property
    def error_bars(self) -> ErrorBarCollection: ...
    def add_error_bars(
        self,
        bar_type: str,
        value_type: str,
        *,
        series_index: int = 0,
        **options: object,
    ) -> None: ...
    def set_error_bars(
        self,
        error_bars: Sequence[ChartErrorBarSpec],
        *,
        series_index: int = 0,
    ) -> None: ...
    def clear_error_bars(self, *, series_index: int = 0) -> None: ...
    @property
    def data_points(self) -> DataPointCollection: ...
    def format_data_point(
        self,
        point_index: int,
        *,
        series_index: int = 0,
        **options: object,
    ) -> None: ...
    def format_data_points(
        self,
        points: Sequence[ChartDataPointSpec],
        *,
        series_index: int = 0,
    ) -> None: ...
    def clear_data_point_formatting(self, *, series_index: int = 0) -> None: ...
    @property
    def data_label_points(self) -> DataLabelPointCollection: ...
    def format_data_label(
        self,
        point_index: int,
        *,
        series_index: int = 0,
        **options: object,
    ) -> None: ...
    def format_data_labels(
        self,
        labels: Sequence[ChartDataLabelPointSpec],
        *,
        series_index: int = 0,
    ) -> None: ...
    def set_data_label_number_format(
        self,
        point_index: int,
        number_format: str,
        *,
        series_index: int = 0,
    ) -> None: ...
    @property
    def data_table(self) -> ChartDataTable: ...
    def set_invert_if_negative(
        self,
        *,
        enabled: bool = True,
        series_index: int = 0,
        negative_fill_color: str | None = None,
    ) -> None: ...
    def replace_data(
        self,
        data: CategoryChartData | XyChartData | ChartDataUpdate,
    ) -> None: ...

